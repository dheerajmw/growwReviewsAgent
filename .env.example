# Groq (Phase 2 theme clustering, Phase 3 note generation)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Phase 5 — HTTP MCP server (https://github.com/dheerajmw/MCP-server)
MCP_SERVER_URL=https://mcp-server-p01x.onrender.com
# Google Doc ID from URL .../document/d/DOC_ID/edit (create Doc once in UI)
GROWW_PULSE_DOC_ID=

# Gmail draft recipient (Phase 6 MCP)
PULSE_DRAFT_TO=you@example.com

# Phase 8 — Streamlit UI calls BFF on Render (not MCP)
PULSE_API_URL=https://YOUR-groww-pulse-api.onrender.com
