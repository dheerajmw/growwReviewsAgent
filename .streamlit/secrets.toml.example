# Streamlit Cloud → Settings → Secrets (TOML)

# Phase 8 BFF on Render (required for React UI data)
PULSE_API_URL = "https://groww-pulse-api.onrender.com"

# React dashboard URL (Pulse 6 UI — same as npm run dev)
# Deploy groww-pulse-ui from render.yaml, then paste its URL here:
PULSE_UI_URL = "https://groww-pulse-ui.onrender.com"

# Set to true to use legacy Python Streamlit pages instead of React embed
# PULSE_STREAMLIT_NATIVE = false
